# Required for application startup
GROQ_API_KEY=
PLATFORM_BACKEND_URL=

# Groq model configuration
GROQ_MODEL=openai/gpt-oss-120b

# Core HTTP behavior
API_TIMEOUT=30

# Optional service URL overrides; unset services use PLATFORM_BACKEND_URL
DASHBOARD_URL=
KPI_INSIGHTS_URL=
ACTIONS_URL=
SEMANTIC_REGISTRY_URL=
KNOWLEDGE_GRAPH_URL=
RULES_SERVICE_URL=
RULE_COMPILATION_URL=
VENDOR_SERVICE_URL=
PROCUREMENT_SERVICE_URL=
INVOICE_SERVICE_URL=
EXPENSE_SERVICE_URL=
MARKET_RISK_SERVICE_URL=

# Optional dashboard and compatibility context configuration
DASHBOARD_ID=
ARIIA_ENTERPRISE_ID=
ARIIA_DOMAIN_IDS=
ARIIA_SCOPE_ID=
ARIIA_SCOPE_HEADER_NAME=X-Scope-Id
ARIIA_COOKIE=
ARIIA_SESSION_ID=
